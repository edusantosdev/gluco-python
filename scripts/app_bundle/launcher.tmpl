#!/bin/sh
# Contents/MacOS/launcher inside the Glucose Menubar.app bundle.
#
# This is intentionally tiny. The .app bundle exists to give AppKit a
# ``CFBundleIdentifier`` (so dialogs / notifications / activation work);
# the actual Python code lives in the repo and is always up to date —
# no rebundle-on-every-edit loop.
#
# ``exec`` replaces this shell with the Python interpreter so
# ``NSBundle.mainBundle`` still resolves to the containing .app
# (Launch Services keyed it to the path that launchd spawned).
set -eu

cd "__REPO_ROOT__"
exec "__VENV_PYTHON__" -m macos_frontend
