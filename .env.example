# Copy this file to `.env` and tweak the values you care about.
# The `.env` file itself is gitignored.
#
# Credentials are NOT configured here. Glucobar reads your LibreView
# email and password only from the macOS Keychain. The menubar app
# prompts for them on first launch; to change them later use the
# "LibreView Account" menu item or run:
#     .venv/bin/python scripts/set_credentials.py

# LibreView region — the LibreView *cluster* name, not every ISO country.
# Valid clusters: US, EU, EU2, AE, AP, AU, CA, DE, FR, JP, LA, RU
# Portugal, Spain, UK, etc. use the EU host: set EU, or keep PT/ES/GB and we map to EU.
# Leave unset to infer it from your locale (falls back to US); if the guess is
# wrong, LibreView redirects the login and the daemon follows it automatically.
# LIBREVIEW_REGION=US

# Exponential backoff on network errors and 429s.
# Starts at ``base``, doubles each consecutive failure, caps at ``cap``.
# A successful poll resets both counters.
# ERROR_BACKOFF_BASE_SECONDS=10
# ERROR_BACKOFF_CAP_SECONDS=300
# RATELIMIT_BACKOFF_BASE_SECONDS=30
# RATELIMIT_BACKOFF_CAP_SECONDS=600
