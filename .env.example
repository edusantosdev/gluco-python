# Copy this file to `.env` and fill in your LibreLinkUp credentials.
# The `.env` file itself is gitignored.

LIBRELINKUP_EMAIL=you@example.com
LIBRELINKUP_PASSWORD=your_password

# LibreLinkUp region — use the LibreView *cluster* name, not every ISO country.
# Valid clusters: US, EU, EU2, AE, AP, AU, CA, DE, FR, JP, LA, RU
# Portugal, Spain, UK, etc. use the EU host: set EU, or keep PT/ES/GB and we map to EU.
LIBRELINKUP_REGION=US

# Poll interval in seconds. 60 is comfortable; lower risks rate-limiting.
POLL_INTERVAL_SECONDS=60

# Menubar colour thresholds (always in mg/dL — the frontend uses
# value_in_mg_per_dl from the daemon, so mmol/L users still get correct colours):
#   value <  THRESHOLD_LOW_MG_DL          → red    (hypo)
#   value in [LOW, HIGH]                  → green  (in range)
#   value in (HIGH, VERY_HIGH]            → yellow (high)
#   value >  THRESHOLD_VERY_HIGH_MG_DL    → orange (very high)
THRESHOLD_LOW_MG_DL=70
THRESHOLD_HIGH_MG_DL=180
THRESHOLD_VERY_HIGH_MG_DL=250
