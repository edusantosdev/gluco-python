# Copy this file to `.env` and fill in your LibreLinkUp credentials.
# The `.env` file itself is gitignored.

# Credentials. You can leave these blank and instead run:
#     .venv/bin/python scripts/set_credentials.py
# to store the email + password in the macOS Keychain. The daemon reads
# Keychain first and falls back to these env vars, so dev and production
# use the same code path.
LIBRELINKUP_EMAIL=you@example.com
LIBRELINKUP_PASSWORD=your_password

# LibreLinkUp region — use the LibreView *cluster* name, not every ISO country.
# Valid clusters: US, EU, EU2, AE, AP, AU, CA, DE, FR, JP, LA, RU
# Portugal, Spain, UK, etc. use the EU host: set EU, or keep PT/ES/GB and we map to EU.
LIBRELINKUP_REGION=US

# Poll interval in seconds. 60 is comfortable; lower risks rate-limiting.
POLL_INTERVAL_SECONDS=60

# Exponential backoff on network errors and 429s.
# Starts at ``base``, doubles each consecutive failure, caps at ``cap``.
# A successful poll resets both counters.
# ERROR_BACKOFF_BASE_SECONDS=10
# ERROR_BACKOFF_CAP_SECONDS=300
# RATELIMIT_BACKOFF_BASE_SECONDS=30
# RATELIMIT_BACKOFF_CAP_SECONDS=600

# Menubar colour thresholds (always in mg/dL — the frontend uses
# value_in_mg_per_dl from the daemon, so mmol/L users still get correct colours):
#   value <  THRESHOLD_LOW_MG_DL          → red    (hypo)
#   value in [LOW, HIGH]                  → green  (in range)
#   value in (HIGH, VERY_HIGH]            → yellow (high)
#   value >  THRESHOLD_VERY_HIGH_MG_DL    → orange (very high)
THRESHOLD_LOW_MG_DL=70
THRESHOLD_HIGH_MG_DL=180
THRESHOLD_VERY_HIGH_MG_DL=250

# Notifications. Set NOTIFY_ENABLED=0 to silence without removing
# thresholds. NOTIFY_STALE_AFTER_SECONDS controls the single
# "sensor hasn't reported" notification; NOTIFY_COOLDOWN_SECONDS is the
# minimum gap between two threshold alerts for the same zone.
# NOTIFY_ENABLED=1
# NOTIFY_STALE_AFTER_SECONDS=600
# NOTIFY_COOLDOWN_SECONDS=900
